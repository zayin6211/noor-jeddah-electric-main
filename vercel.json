{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build/client",
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/electrical-foundation",
      "destination": "/services/electrical-foundation/index.html"
    },
    {
      "source": "/services/electrical-wiring",
      "destination": "/services/electrical-wiring/index.html"
    },
    {
      "source": "/services/electrical-finishing",
      "destination": "/services/electrical-finishing/index.html"
    },
    {
      "source": "/services/lighting",
      "destination": "/services/lighting/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}